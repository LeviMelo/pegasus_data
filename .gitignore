__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# runtime data
data/
lake/
blobs/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
scratch/

# Scratch that lands in the repo root when an agent or a shell one-liner
# downloads something without choosing a directory. Project content lives in
# src/, tests/, scripts/, docs/ and curation/ — never loose at the top level.
/*.html
/*.htm
/*.tmp
/ev*.yml
/bd.yml

# Downloaded archives an agent or a script fetched while working. Large,
# reproducible, and one of them (TAB_CNES.zip, 120 MB) exceeded GitHub's
# 100 MB limit and blocked every push until it was removed from history.
.cache_dl/

# Project-local placement config: paths are machine-specific.
pegasus-data.toml
.pegasus-data.toml

# Reference material the curation cites: Ministry of Health record layouts,
# .DEF/.CNV codelist definitions, extracted evidence files. Kept next to the
# project so the evidence trail survives a temp-folder sweep, but not committed
# (1.3 GB, and re-downloadable from the DATASUS FTP tree).
# curation/sources.yml is the committed manifest that says what each one is.
/sources/

# The data home: catalog, lake, blob cache and produced exports. 154 MB after a
# handful of fetches and it only grows, and every byte of it is rebuildable from
# the tree. `pegasus-data where` prints which one is in effect.
/pegasus_data_home/
/home_e2e/

# Source snapshots packed up to send somewhere — an external review, a colleague.
# The repo IS the source; a zip of it is a copy that goes stale silently, and
# src.zip was 34 MB of one.
/src.zip
/src(*).zip
/pegasus_data_source.zip
src/pegasus_data/decode/_native/*.dll
src/pegasus_data/decode/_native/*.obj
src/pegasus_data/decode/_native/*.lib
src/pegasus_data/decode/_native/*.exp
